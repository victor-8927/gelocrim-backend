# Cole aqui os dados do Supabase (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.XXXX.supabase.co:5432/postgres

# Cole aqui os dados do Redis Cloud (Configuration > Endpoint + Password)
REDIS_URL=redis://:SUA_SENHA@redis-XXXX.c1.us-east-1-2.ec2.redns.redis-cloud.com:12345

# Segredo JWT — crie qualquer string longa
JWT_SECRET=minha-chave-super-secreta-para-tokens-jwt-2026

# Coordenadas do seu depósito em Manaus
DEPOT_LAT=-3.1019
DEPOT_LNG=-60.0250

# Tempo máximo do solver em segundos
VRP_TIME_LIMIT_SEC=30
